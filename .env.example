# Copy to .env. Never commit real secrets.
NYAYA_DATABASE_URL=postgresql+psycopg://nyaya:nyaya@db:5432/nyayasetu
NYAYA_REDIS_URL=redis://redis:6379/0
NYAYA_JWT_SECRET=replace-with-64-random-characters
# Fernet key for encrypting uploaded documents at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NYAYA_DOCUMENTS_ENCRYPTION_KEY=
# LLM (optional). Without it, deterministic extractors are used and drafting skips wording polish.
NYAYA_LLM_PROVIDER=none
NYAYA_ANTHROPIC_API_KEY=
NYAYA_ANTHROPIC_MODEL=claude-opus-5-5
# Demo only: marks legal records as verified with an explicit "DEMO SEED — NOT a legal check" label.
NYAYA_DEMO_MODE=true
NYAYA_CONFIDENCE_THRESHOLD=0.8
NYAYA_CORS_ORIGINS=["http://localhost:3000"]
